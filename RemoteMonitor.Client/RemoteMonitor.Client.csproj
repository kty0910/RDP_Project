<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\Assets\client-r.ico</ApplicationIcon>
    <EnableBridgeToken Condition="'$(EnableBridgeToken)' == ''">true</EnableBridgeToken>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableBridgeToken)' == 'true'">
    <DefineConstants>$(DefineConstants);BRIDGE_TOKEN_REQUIRED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Assets\client-r.ico" LogicalName="RemoteMonitor.Client.AppIconR" />
  </ItemGroup>

</Project>
