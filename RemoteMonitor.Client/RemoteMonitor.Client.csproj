<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <ApplicationIcon>..\Assets\client-r.ico</ApplicationIcon>
    <EnableBridgeToken Condition="'$(EnableBridgeToken)' == ''">false</EnableBridgeToken>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableBridgeToken)' == 'true'">
    <DefineConstants>$(DefineConstants);BRIDGE_TOKEN_REQUIRED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Assets\client-r.ico" LogicalName="RemoteMonitor.Client.AppIconR" />
    <Compile Include="..\Shared\ApplicationSettingsForm.cs" Link="Forms\ApplicationSettingsForm.cs" />
    <Compile Include="..\Shared\RichDescriptionEditor.cs" Link="Forms\RichDescriptionEditor.cs" />
    <Compile Include="..\Shared\WindowsShortcutService.cs" Link="Services\WindowsShortcutService.cs" />
  </ItemGroup>

</Project>
